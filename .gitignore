# Jekyll build output and caches
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Local Ruby tooling (only used for previewing on your own computer)
.bundle/
vendor/
Gemfile.lock

# OS clutter
.DS_Store
Thumbs.db

# The Studio's build tools (studio-src/), installed with `npm install`
node_modules/

# The Stocks pipeline's working folders (the workflow writes here)
build/
previous/
__pycache__/

# Written by the Vercel build (see vercel.json)
_config.vercel.yml
